ANY_SECRET=VALUE

# Optional — required only when indexer/balance features are wired
# WDK_INDEXER_BASE_URL=https://wdk-api.tether.io
# WDK_INDEXER_API_KEY=

# Google Sign-In OAuth client IDs (from Google Cloud Console)
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# API
API_BASE_URL=http://localhost:3000/api

# TronGrid credentials (https://www.trongrid.io). Strongly recommended: without
# a key, Tron runs on the anonymous tier and balance polling gets rate-limited
# (HTTP 429). TRON_API_SECRET is only needed for a Pro key.
TRON_API_KEY=your-trongrid-api-key
# TRON_API_SECRET=your-trongrid-api-secret
