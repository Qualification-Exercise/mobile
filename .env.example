ANY_SECRET=VALUE

# Backend API base URL (must include /api prefix)
BACKEND_API_URL=https://your-backend.com/api

# Optional — required only when indexer/balance features are wired
# WDK_INDEXER_BASE_URL=https://wdk-api.tether.io
# WDK_INDEXER_API_KEY=
# TRON_API_KEY=
# TRON_API_SECRET=

# Google Sign-In OAuth client IDs (from Google Cloud Console)
# GOOGLE_WEB_CLIENT_ID must match the backend's GOOGLE_WEB_CLIENT_ID — the app
# sends idTokens with that client as audience (type=web on POST /auth/google).
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
