{
  "name": "wdkqualification",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "prepare": "husky",
    "start": "concurrently -n wdk,metro -c blue,green \"npm run wdk:watch\" \"react-native start\"",
    "start:metro": "react-native start",
    "expo:start": "EXPO_UNSTABLE_MCP_SERVER=1 expo start",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "wdk:bundle": "wdk-worklet-bundler generate --install",
    "wdk:watch": "onchange 'wdk.config.js' -- npm run wdk:bundle",
    "postinstall": "npm run wdk:bundle"
  },
  "dependencies": {
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@buildonspark/spark-sdk": "^0.9.0",
    "@react-native/new-app-screen": "0.86.2",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "@tetherto/wdk": "^1.0.0-beta.14",
    "@tetherto/wdk-react-native-core": "^1.0.0-beta.15",
    "@tetherto/wdk-wallet-evm-erc-4337": "^1.0.0-beta.13",
    "@tetherto/wdk-wallet-spark": "^1.0.0-beta.22",
    "@tetherto/wdk-wallet-tron": "^1.0.0-beta.9",
    "bufferutil": "^4.1.0",
    "expo": "~57.0.0",
    "mobx": "^6.16.1",
    "mobx-react-lite": "^4.1.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "^3.1.0",
    "react-native-keychain": "^10.0.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.26.2",
    "utf-8-validate": "^5.0.10"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/eslint-config": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@react-native/metro-config": "0.86.2",
    "@react-native/typescript-config": "0.86.2",
    "@tetherto/wdk-worklet-bundler": "^1.0.0-beta.6",
    "@types/jest": "^29.5.13",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "concurrently": "^9.1.0",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^8.19.0",
    "expo-mcp": "~0.2.1",
    "husky": "^9.1.7",
    "onchange": "^7.1.0",
    "jest": "^29.6.3",
    "lint-staged": "^17.2.0",
    "prettier": "2.8.8",
    "react-native-dotenv": "^4.1.1",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
