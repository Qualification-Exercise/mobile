<?xml version="1.0" encoding="utf-8"?>
<!-- Cold-start window background: the app's own dark surface with the wallet
     mark centred, so launch does not flash white before React mounts. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/brandBackground" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_mark" />
    </item>
</layer-list>
