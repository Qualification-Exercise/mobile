# Fastlane lanes for shipping the app to TestFlight (iOS) and the Play Console
# internal track (Android). Both lanes are driven entirely by environment
# variables set in .github/workflows/cd.yml so nothing sensitive is committed.
#
# Shared env:
#   BUILD_NUMBER       — a build number that is unique and always goes up. We use
#                        the GitHub run number so every upload is accepted.
#   MARKETING_VERSION  — the version users see, e.g. "1.2.3" (taken from the git
#                        tag). Optional: when blank we keep the project's value.

require "fileutils"

IOS_PROJECT = "ios/wdkqualification.xcodeproj".freeze
IOS_WORKSPACE = "ios/wdkqualification.xcworkspace".freeze
IOS_SCHEME = "wdkqualification".freeze
BUNDLE_ID = ENV["IOS_BUNDLE_ID"] || "org.reactjs.native.example.wdkqualification"

default_platform(:ios)

platform :ios do
  desc "Build and upload a new build to TestFlight"
  lane :build do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8"],
      is_key_content_base64: true,
    )

    build_ios_release(api_key: api_key)

    upload_to_testflight(
      api_key: api_key,
      # Don't block the CI job while Apple processes the build.
      skip_waiting_for_build_processing: true,
      # Goes to internal testers only; no external/public TestFlight release.
      distribute_external: false,
    )
  end

  desc "Build a signed .ipa locally without uploading (to verify the build)"
  lane :build_local do
    # Runs the exact same signing + archive + export as `build`, but stops
    # before the upload so you can inspect the .ipa. Requires APPLE_TEAM_ID and
    # the match secrets (MATCH_GIT_URL, MATCH_PASSWORD) in your environment. No
    # App Store Connect API key is needed: match runs read-only and nothing is
    # uploaded.
    build_ios_release

    UI.success("Built #{lane_context[SharedValues::IPA_OUTPUT_PATH]}")
  end
end

platform :android do
  desc "Build and upload a new build to the Play Console internal track"
  lane :build do
    # Build a signed release AAB. VERSION_CODE is passed through to Gradle
    # (build.gradle reads it) so each upload has a unique version code.
    gradle(
      task: "bundle",
      build_type: "Release",
      project_dir: "android",
      properties: {
        "VERSION_CODE" => ENV["BUILD_NUMBER"],
      },
    )

    upload_to_play_store(
      track: "internal",
      # Path to the .aab the gradle step just produced.
      aab: lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH],
      json_key_data: ENV["PLAY_SERVICE_ACCOUNT_JSON"],
      # Upload only the app binary; the store listing, screenshots, and text are
      # managed by hand in the Play Console, not by this pipeline.
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end
end

# Shared iOS build steps used by both `build` and `build_local`: install the
# match-managed signing assets, force manual signing, and archive/export a
# signed .ipa via gym. Pass an App Store Connect api_key when one is available
# (CI) so match can authenticate non-interactively; it is optional for local
# read-only builds. Leaves the .ipa in build/ios.
def build_ios_release(api_key: nil)
  # Both the code-signing settings and the rendered ExportOptions.plist need the
  # team id, so fail fast with a clear message when it is missing.
  if ENV["APPLE_TEAM_ID"].to_s.empty?
    UI.user_error!("APPLE_TEAM_ID must be set to sign the build")
  end

  # On CI, create a temporary keychain so match can install the distribution
  # certificate without touching a shared login keychain.
  setup_ci if is_ci

  match(
    type: "appstore",
    readonly: true,
    api_key: api_key,
  )

  # Force manual signing with the match-managed profile for the archive.
  update_code_signing_settings(
    use_automatic_signing: false,
    path: IOS_PROJECT,
    team_id: ENV["APPLE_TEAM_ID"],
    code_sign_identity: "Apple Distribution",
    bundle_identifier: BUNDLE_ID,
    profile_name: "match AppStore #{BUNDLE_ID}",
  )

  # Render ExportOptions.plist with the real team id (kept as a placeholder in
  # the committed file so no account details are checked in).
  export_options_path = render_export_options

  # Set the build number (and version, if given) as Xcode build settings passed
  # on the command line. This avoids editing and committing the Xcode project
  # just to bump a number. CURRENT_PROJECT_VERSION is the build number;
  # MARKETING_VERSION is the user-facing version. BUILD_NUMBER is always set in
  # CI; default it to 1 so local builds work without extra env.
  build_number = ENV["BUILD_NUMBER"].to_s.empty? ? "1" : ENV["BUILD_NUMBER"]
  xcargs = ["CURRENT_PROJECT_VERSION=#{build_number}"]
  marketing = ENV["MARKETING_VERSION"].to_s
  xcargs << "MARKETING_VERSION=#{marketing}" unless marketing.empty?

  gym(
    workspace: IOS_WORKSPACE,
    scheme: IOS_SCHEME,
    configuration: "Release",
    export_method: "app-store",
    export_options: export_options_path,
    xcargs: xcargs.join(" "),
    output_directory: "build/ios",
    clean: true,
  )
end

# Substitute the Apple Team ID into a working copy of ExportOptions.plist and
# return its path. Falls back to the committed file when APPLE_TEAM_ID is unset
# (local use, where the placeholder is expected to be edited by hand).
def render_export_options
  source = "ios/ExportOptions.plist"
  team_id = ENV["APPLE_TEAM_ID"].to_s
  return source if team_id.empty?

  FileUtils.mkdir_p("build")
  rendered = "build/ExportOptions.generated.plist"
  File.write(rendered, File.read(source).gsub("REPLACE_WITH_TEAM_ID", team_id))
  rendered
end
